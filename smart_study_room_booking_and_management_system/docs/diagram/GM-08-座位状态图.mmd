stateDiagram-v2
    direction LR
    state "【生命周期视角】" as Life {
        [*] --> 可用 : 管理员新增座位
        可用 --> 维护中 : 管理员标记维护
        维护中 --> 可用 : 维护完成恢复
        可用 --> 停用 : 管理员停用<br/>UC-07/FR-06
        维护中 --> 停用 : 管理员停用
        停用 --> 可用 : 管理员恢复启用
    }
    state "【时段占用视角】某座位在某时段" as Occ {
        [*] --> 空闲
        空闲 --> 已预约 : ST-08 预约成功<br/>UC-01
        已预约 --> 空闲 : ST-09 取消/自动违约释放<br/>UC-02/C-1
        已预约 --> 使用中 : ST-10 本人签到<br/>UC-03
        使用中 --> 空闲 : ST-11 签退释放剩余时段<br/>C-3/BR-09
        使用中 --> 空闲 : ST-12 手动违约释放<br/>UC-04
    }
    Life --> Occ : 仅"可用"座位开放时段占用
    note right of Life
        约束 F-4：维护中/停用的座位
        拒绝新预约
    end note
